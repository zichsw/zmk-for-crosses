#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define EXTRA 1
#define TAP 2
#define BUTTON 3
#define NAV 4
#define MOUSE 5
#define MEDIA 6
#define NUM 7
#define SYM 8
#define FUN 9

&lt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    quick-tap-ms = <150>;
};

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    quick-tap-ms = <150>;
};

/ {
    macros {
        bt_rescue: bt_rescue {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_CLR_ALL>, <&out OUT_BLE>;
        };
    };

    combos {
        compatible = "zmk,combos";

        bt_rescue_combo {
            timeout-ms = <50>;
            key-positions = <16 17 18 19>;
            layers = <BASE>;
            bindings = <&bt_rescue>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            bindings = <
&kp Q          &kp W       &kp E       &kp R        &kp T        &kp Y        &kp U          &kp I          &kp O       &kp P
&mt LGUI A     &mt LALT S  &mt LCTRL D &mt LSHFT F  &kp G        &kp H        &mt RSHFT J    &mt RCTRL K    &mt RALT L  &mt RGUI SQT
&lt BUTTON Z   &kp X       &kp C       &kp V        &kp B        &kp N        &kp M          &kp COMMA      &kp DOT     &lt BUTTON SLASH
                                      &lt MEDIA ESC &lt NAV SPACE &lt MOUSE TAB &lt SYM ENTER &lt NUM BACKSPACE &lt FUN DELETE
            >;
        };

        Extra {
            bindings = <
&kp Q    &kp W    &kp E    &kp R    &kp T        &kp Y        &kp U          &kp I          &kp O          &kp P
&kp A    &kp S    &kp D    &kp F    &kp G        &kp H        &kp J          &kp K          &kp L          &kp SQT
&kp Z    &kp X    &kp C    &kp V    &kp B        &kp N        &kp M          &kp COMMA      &kp DOT        &kp SLASH
                            &kp ESC  &kp SPACE    &kp TAB      &kp ENTER      &kp BACKSPACE  &kp DELETE
            >;
        };

        Tap {
            bindings = <
&kp Q    &kp W    &kp E    &kp R    &kp T        &kp Y        &kp U          &kp I          &kp O          &kp P
&kp A    &kp S    &kp D    &kp F    &kp G        &kp H        &kp J          &kp K          &kp L          &kp SQT
&kp Z    &kp X    &kp C    &kp V    &kp B        &kp N        &kp M          &kp COMMA      &kp DOT        &kp SLASH
                            &kp ESC  &kp SPACE    &kp TAB      &kp ENTER      &kp BACKSPACE  &kp DELETE
            >;
        };

        Button {
            bindings = <
&trans  &trans  &trans  &trans  &trans      &trans      &trans      &trans      &trans      &trans
&trans  &trans  &trans  &trans  &trans      &trans      &trans      &trans      &trans      &trans
&trans  &trans  &trans  &trans  &trans      &trans      &trans      &trans      &trans      &trans
                        &mkp MCLK &mkp LCLK &mkp RCLK   &mkp RCLK   &mkp LCLK   &mkp MCLK
            >;
        };

        Nav {
            bindings = <
&trans       &trans     &trans      &trans     &trans       &kp LG(Z)       &kp LG(X)     &kp LG(C)     &kp LG(V)      &kp LG(LS(Z))
&kp LGUI     &kp LALT   &kp LCTRL   &kp LSHFT  &trans       &kp CAPSLOCK    &kp LEFT      &kp DOWN      &kp UP         &kp RIGHT
&trans       &trans     &trans      &trans     &trans       &kp INSERT      &kp HOME      &kp PG_DN     &kp PG_UP      &kp END
                                      &kp ESC   &trans       &kp TAB         &kp ENTER     &kp BACKSPACE &kp DELETE
            >;
        };

        Mouse {
            bindings = <
&trans  &trans  &trans  &trans  &trans      &trans      &trans      &trans      &trans      &trans
&trans  &trans  &trans  &trans  &trans      &trans      &trans      &trans      &trans      &trans
&trans  &trans  &trans  &trans  &trans      &trans      &trans      &trans      &trans      &trans
                        &mkp MCLK &mkp LCLK &mkp RCLK   &mkp RCLK   &mkp LCLK   &mkp MCLK
            >;
        };

        Media {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_CLR  &trans      &trans       &kp C_VOLUME_UP    &trans          &trans
&kp LGUI      &kp LALT      &kp LCTRL     &kp LSHFT     &trans      &trans      &kp C_PREV    &kp C_VOLUME_DOWN  &kp C_NEXT      &trans
&out OUT_BLE  &out OUT_USB  &trans        &trans        &trans      &trans      &trans        &trans             &trans          &trans
                                                      &trans        &trans      &trans        &kp C_PLAY_PAUSE   &kp C_MUTE      &kp C_STOP
            >;
        };

        Num {
            bindings = <
&kp LBKT  &kp N7  &kp N8  &kp N9  &kp RBKT     &trans      &trans      &trans      &trans      &trans
&kp SEMI  &kp N4  &kp N5  &kp N6  &kp EQUAL    &trans      &kp RSHFT   &kp RCTRL   &kp RALT    &kp RGUI
&kp GRAVE &kp N1  &kp N2  &kp N3  &kp BSLH     &trans      &trans      &trans      &trans      &trans
                             &kp DOT &kp N0     &kp MINUS   &trans      &trans      &trans
            >;
        };

        Sym {
            bindings = <
&kp LBRC   &kp AMPS  &kp ASTRK  &kp LPAR  &kp RBRC      &trans      &trans      &trans      &trans      &trans
&kp COLON  &kp DLLR  &kp PRCNT  &kp CARET &kp PLUS      &trans      &kp RSHFT   &kp RCTRL   &kp RALT    &kp RGUI
&kp TILDE  &kp EXCL  &kp AT     &kp HASH  &kp PIPE      &trans      &trans      &trans      &trans      &trans
                                &kp LPAR  &kp RPAR      &kp UNDER   &trans      &trans      &trans
            >;
        };

        Fun {
            bindings = <
&kp F12    &kp F7  &kp F8  &kp F9  &kp PRINTSCREEN   &trans      &trans      &trans      &trans      &trans
&kp F11    &kp F4  &kp F5  &kp F6  &kp SCROLLLOCK    &trans      &kp RSHFT   &kp RCTRL   &kp RALT    &kp RGUI
&kp F10    &kp F1  &kp F2  &kp F3  &kp PAUSE_BREAK   &trans      &trans      &trans      &trans      &trans
                             &kp K_APP &kp SPACE      &kp TAB     &trans      &trans      &trans
            >;
        };
    };
};
